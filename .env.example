ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

SECRET_KEY=replace-with-a-long-random-string

# --- Remote GPU box (DGX Spark) — optional ---
# Offloads YOLO training (and optionally batch inference) to a companion
# server running `yale-qc train-server` on the box. Leave unset to run
# everything locally.
SPARK_IP=10.74.82.14
# TRAIN_SERVER_URL overrides the SPARK_IP:8100 default if set:
# TRAIN_SERVER_URL=http://10.74.82.14:8100
TRAIN_SERVER_TOKEN=replace-with-a-shared-secret
# Set to 1 to also run batch-pass inference on the box:
REMOTE_INFERENCE=0
